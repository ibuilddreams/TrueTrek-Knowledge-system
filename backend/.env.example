SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.coolnerdz.com,test.coolnerdz.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.coolnerdz.com,https://test.coolnerdz.com,http://test.coolnerdz.com,http://api.coolnerdz.com
CORS_ALLOWED_ORIGINS=https://api.coolnerdz.com,https://test.coolnerdz.com,http://test.coolnerdz.com,http://api.coolnerdz.com

DB_NAME=truetrek_lms
DB_USER=truetrek
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Set development locally and production on the server.
APP_ENV=production
DEV_FRONTEND_URL=http://localhost:3000
PRODUCTION_FRONTEND_URL=https://test.coolnerdz.com
PASSWORD_RESET_TIMEOUT=3600

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Feedback submission notifications (server-side only)
PRAXIN_CLIENT_EMAIL=
DEFAULT_FROM_EMAIL=no-reply@truetrek.edu

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Gemini — used by advisor chat, quiz/assignment AI grading, AI content
# suggestions and the daily drill. NOT used by full-course generation any more:
# that calls our own LLM service (see AI_COURSE_SERVICE_URL below). GEMINI_API_KEY has no
# default and must be set for those features to work — a missing key fails loudly
# with an honest error, never an offline/placeholder result. Oumar's key goes here;
# swapping providers later only means adding a new class under ai_courses/providers/
# and changing AI_PROVIDER — no call sites change.
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
# Used by the advisor app's live chat instead of AI_MODEL — a fast, non-"thinking"
# model so chat replies land in a few seconds instead of AI_MODEL's 10-20s+
# reasoning overhead, which is fine for a backgrounded course-generation job but
# not for a synchronous chat reply.
AI_CHAT_MODEL=gemini-3.1-flash-lite
AI_REQUEST_TIMEOUT=120
AI_MAX_MODULES=12
AI_MAX_LESSONS=10
AI_MONTHLY_LIMIT=50
AI_MAX_CONCURRENT_GENERATIONS=3
AI_STALE_JOB_THRESHOLD_SECONDS=300

# Self-hosted course-generation LLM (ai_courses) — what "Create with AI" on
# Admin → Courses calls; Gemini is no longer involved in that flow. The service
# is unauthenticated and its address is baked into settings.py, so there is
# nothing to set here. Uncomment only to point a staging box somewhere else
# (the service root, WITHOUT /api/v1).
# AI_COURSE_SERVICE_URL=

# NDA-approved invitation account setup
INVITATION_EXPIRY_HOURS=72
EMAIL_TIMEOUT=10
