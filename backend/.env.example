SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.coolnerdz.com,test.coolnerdz.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.coolnerdz.com,https://test.coolnerdz.com,http://test.coolnerdz.com,http://api.coolnerdz.com
CORS_ALLOWED_ORIGINS=https://api.coolnerdz.com,https://test.coolnerdz.com,http://test.coolnerdz.com,http://api.coolnerdz.com

DB_NAME=truetrek_lms
DB_USER=truetrek
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Set development locally and production on the server.
APP_ENV=production
DEV_FRONTEND_URL=http://localhost:3000
PRODUCTION_FRONTEND_URL=https://test.coolnerdz.com
PASSWORD_RESET_TIMEOUT=3600

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Feedback submission notifications (server-side only)
PRAXIN_CLIENT_EMAIL=
DEFAULT_FROM_EMAIL=no-reply@truetrek.edu

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Gemini — used by advisor chat, quiz/assignment AI grading, AI content
# suggestions and the daily drill. NOT used by full-course generation any more:
# that calls our own LLM service (see AI_COURSE_SERVICE_URL below). GEMINI_API_KEY has no
# default and must be set for those features to work — a missing key fails loudly
# with an honest error, never an offline/placeholder result. Oumar's key goes here;
# swapping providers later only means adding a new class under ai_courses/providers/
# and changing AI_PROVIDER — no call sites change.
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
# Used by the advisor app's live chat instead of AI_MODEL — a fast, non-"thinking"
# model so chat replies land in a few seconds instead of AI_MODEL's 10-20s+
# reasoning overhead, which is fine for a backgrounded course-generation job but
# not for a synchronous chat reply.
AI_CHAT_MODEL=gemini-3.1-flash-lite
AI_REQUEST_TIMEOUT=120
AI_MAX_MODULES=12
AI_MAX_LESSONS=10
AI_MONTHLY_LIMIT=50
AI_MAX_CONCURRENT_GENERATIONS=3
AI_STALE_JOB_THRESHOLD_SECONDS=300

# Self-hosted course-generation LLM (ai_courses) — what "Create with AI" on
# Admin → Courses calls; Gemini is no longer involved in that flow. The service
# is unauthenticated and its address is baked into settings.py, so there is
# nothing to set here. Uncomment only to point a staging box somewhere else
# (the service root, WITHOUT /api/v1).
# AI_COURSE_SERVICE_URL=

# NDA-approved invitation account setup
INVITATION_EXPIRY_HOURS=72
EMAIL_TIMEOUT=10

# Agora RTC — the live classroom (class_sessions/). Both come from the Agora
# Console: Projects > your project > App ID, and Security > Primary
# Certificate. They must belong to the SAME project, and the App ID here must
# match the frontend's NEXT_PUBLIC_AGORA_APP_ID — a token is signed for one
# App ID and Agora rejects it under any other. The certificate is a signing
# secret: it stays here and is never sent to a browser.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Agora Interactive Whiteboard — the board a teacher presents on inside a live
# class (class_sessions/whiteboard.py). A SEPARATE Agora product from the RTC
# credentials above, with its own console section: Projects > your project >
# Whiteboard (enable it first), then "App Identifier" and the AK/SK pair under
# the same panel. All three must come from that one panel. The Secret Key is a
# signing secret: it stays here and is never sent to a browser.
#
# Leave them empty and live classes run exactly as before — the whiteboard
# button is shown disabled, saying it isn't configured on this server.
#
# The App Identifier is TWO parts with a slash — <team>/<app>, e.g.
# 283b7Ff0.../9aX2bYc... — and the console shows it that way. Copying only the
# half after the slash is the usual mistake; the server now refuses it with a
# clear message rather than letting the browser fail inside the SDK.
AGORA_WHITEBOARD_APP_IDENTIFIER=
AGORA_WHITEBOARD_ACCESS_KEY=
AGORA_WHITEBOARD_SECRET_KEY=
# Where new whiteboard rooms are created: us-sv (Silicon Valley), sg
# (Singapore), in-mum (Mumbai), eu (Frankfurt) or cn-hz (Hangzhou). Pick the
# one nearest your students. Changing it only affects boards opened from then
# on — each room remembers the region it was created in.
AGORA_WHITEBOARD_REGION=us-sv

# The Agora console's RESTful API key: Console > Developer Toolkit >
# "RESTful API" > add a secret, which gives a Customer ID and a Customer
# Secret. These are NOT the App Certificate above and NOT the whiteboard's
# Access Key.
#
# There is exactly ONE of these per account, not one per product — Cloud
# Recording and Real-Time Transcription (the AI meeting notes, further down)
# both authenticate with this same pair, which is why it is named for the
# account rather than for a feature.
#
# Leave them empty and live classes run exactly as before; the record and
# notes buttons are shown disabled, saying they aren't configured here.
#
# (AGORA_RECORDING_CUSTOMER_ID / _SECRET and AGORA_STT_CUSTOMER_ID / _SECRET
# override this pair for one product only. They exist for a deployment that
# was issued a second key, or that wants to revoke one product's access
# without touching the other. Almost nobody needs them.)
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Where the recordings are kept. Agora does NOT host them: its recorder
# uploads straight into a bucket you own, and these credentials are what let
# it write there. The same pair signs the playback links students click, so
# the key needs both PutObject and GetObject on this bucket.
#
# Keep the bucket PRIVATE. A recording is released only as a signed link that
# expires in hours, minted for one viewer at a time behind the same enrolment
# check that guards the classroom itself.
AGORA_RECORDING_BUCKET=
AGORA_RECORDING_ACCESS_KEY=
AGORA_RECORDING_SECRET_KEY=

# Which storage product, in Agora's own numbering (its cloud-recording
# "start" API documents these under storageConfig.vendor):
#   1  Amazon S3          2  Alibaba Cloud     3  Tencent Cloud
#   5  Microsoft Azure    6  Google Cloud      7  Huawei Cloud
#   8  Baidu IntelligentCloud
#   11 any S3-compatible store (Cloudflare R2, MinIO, DigitalOcean Spaces,
#      Wasabi) — this one ALSO needs AGORA_RECORDING_S3_ENDPOINT below.
AGORA_RECORDING_VENDOR=1

# The same region, twice, in the two spellings the two services use.
# AGORA_RECORDING_STORAGE_REGION is Agora's own integer for a region of the
# vendor above; that numbering is not on the same docs page as the vendor
# list, so look it up rather than guessing before you change it from 0.
# S3_REGION is how AWS itself writes the region, and is what signs the
# playback links students click. The two must describe the SAME place, or
# recordings upload somewhere they cannot be played back from.
AGORA_RECORDING_STORAGE_REGION=0
AGORA_RECORDING_S3_REGION=us-east-1

# Only for an S3-compatible store that isn't AWS (vendor 11 above). Leave
# empty for AWS itself. Agora wants a bare domain and our own URL signer
# wants a scheme — set the full URL here and the server strips the scheme
# when it talks to Agora.
#   Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
#   DO Spaces:      https://<region>.digitaloceanspaces.com
#   Wasabi:         https://s3.<region>.wasabisys.com
#   MinIO:          https://minio.your-domain.com
# PATH_STYLE is what MinIO and some self-hosted gateways need; getting it
# wrong reads as a 404 for a file that is plainly there.
AGORA_RECORDING_S3_ENDPOINT=
AGORA_RECORDING_S3_PATH_STYLE=false

# Optional CDN in front of the bucket. Setting it stops anything being signed,
# which means the recordings behind it are public to anyone with the URL — so
# set it only if that is genuinely what you want.
AGORA_RECORDING_PUBLIC_BASE_URL=

# How long a playback link lives. Short on purpose: the "Watch recording"
# button asks for a fresh one on every click.
AGORA_RECORDING_URL_TTL_SECONDS=21600

# Recording is billed per minute on top of the class's own call minutes. Set
# this to false to switch the whole feature off for this deployment without
# touching the per-class setting teachers see.
AGORA_RECORDING_ENABLED=true

# Whether a finished recording is also emailed to the class, on top of the
# in-app notification. The email links to the portal, never to the recording
# itself — a playback link is signed for one viewer and expires in hours,
# while an email outlives it and can be forwarded to anyone.
CLASS_RECORDING_EMAIL_ENABLED=true

# Agora Real-Time Transcription — the AI meeting notes a class is written up
# into afterwards (class_sessions/transcription_api.py). A FOURTH Agora
# product, enabled separately on an Agora project (on many projects Agora has
# to turn it on for you) and failing separately here: a server that can run
# and record a class but not write it up is an ordinary state, and the
# classroom just shows the notes button disabled with the reason.
#
# It needs NO bucket settings of its own — Agora writes a class's captions
# into the same bucket its recorder uploads video to, so the
# AGORA_RECORDING_BUCKET block above serves both.
#
# It needs NO key of its own either: AGORA_CUSTOMER_ID / _SECRET above is
# the account's one RESTful key and every Agora REST product uses it. Leave
# these two empty unless you were issued a second key, or you want to revoke
# transcription's access without touching recording's.
AGORA_STT_CUSTOMER_ID=
AGORA_STT_CUSTOMER_SECRET=

# Writing the notes themselves goes through the AI provider (GEMINI_API_KEY),
# so notes stay switched off until that is set too — a class transcribed with
# nothing to summarise it is a bill for nothing.
#
# Transcription is billed per minute on top of the class's own call minutes,
# and separately from recording. Set this to false to switch the whole
# feature off for this deployment without touching the per-class setting
# teachers see.
CLASS_NOTES_ENABLED=true

# What Agora listens for, comma-separated. At most four — it refuses the whole
# request if given more — and every extra language costs accuracy on the
# others, so list only what is actually spoken in your classes.
CLASS_NOTES_LANGUAGES=en-US

# Whether finished notes are also emailed to the class, on top of the in-app
# notification. The email links to the portal, never to the notes document.
CLASS_NOTES_EMAIL_ENABLED=true
