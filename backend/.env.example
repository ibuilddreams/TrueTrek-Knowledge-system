SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.coolnerdz.com,test.coolnerdz.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.coolnerdz.com,https://test.coolnerdz.com,http://test.coolnerdz.com,http://api.coolnerdz.com
CORS_ALLOWED_ORIGINS=https://api.coolnerdz.com,https://test.coolnerdz.com,http://test.coolnerdz.com,http://api.coolnerdz.com

DB_NAME=truetrek_lms
DB_USER=truetrek
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# development locally, production on the server
APP_ENV=production
DEV_FRONTEND_URL=http://localhost:3000
PRODUCTION_FRONTEND_URL=https://test.coolnerdz.com
PASSWORD_RESET_TIMEOUT=3600

# Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@truetrek.edu
# Where feedback submissions are sent.
PRAXIN_CLIENT_EMAIL=

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

INVITATION_EXPIRY_HOURS=72


# --- AI ----------------------------------------------------------------
# Gemini: advisor chat, AI grading, content suggestions, daily drill and
# class notes. Full-course generation uses our own service instead.
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
# Faster model for live chat, where AI_MODEL's reasoning delay is too slow.
AI_CHAT_MODEL=gemini-3.1-flash-lite
AI_REQUEST_TIMEOUT=120
AI_MAX_MODULES=12
AI_MAX_LESSONS=10
AI_MONTHLY_LIMIT=50
AI_MAX_CONCURRENT_GENERATIONS=3
AI_STALE_JOB_THRESHOLD_SECONDS=300

# Course-generation service. Its address is in settings.py; set this only to
# point somewhere else (service root, no /api/v1).
# AI_COURSE_SERVICE_URL=


# --- Live classes: video -----------------------------------------------
# Agora Console > your project > App ID, and Security > Primary Certificate.
# Same project, and the App ID must match NEXT_PUBLIC_AGORA_APP_ID.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=


# --- Live classes: whiteboard ------------------------------------------
# Separate Agora product: Console > your project > Whiteboard.
# The App Identifier is <team>/<app> — copy the whole thing, slash included.
# Leave empty and the whiteboard button is simply disabled.
AGORA_WHITEBOARD_APP_IDENTIFIER=
AGORA_WHITEBOARD_ACCESS_KEY=
AGORA_WHITEBOARD_SECRET_KEY=
# us-sv, sg, in-mum, eu or cn-hz. Only affects new boards.
AGORA_WHITEBOARD_REGION=us-sv


# --- Live classes: recording -------------------------------------------
# Agora Console > Developer Toolkit > RESTful API. One key per account, used
# by recording and transcription alike. Not the App Certificate.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Agora uploads recordings into a bucket you own. Keep it PRIVATE — playback
# links are signed per viewer and expire. Needs PutObject and GetObject.
AGORA_RECORDING_BUCKET=
AGORA_RECORDING_ACCESS_KEY=
AGORA_RECORDING_SECRET_KEY=

# Agora's vendor numbering: 1 AWS, 2 Alibaba, 3 Tencent, 5 Azure, 6 Google,
# 7 Huawei, 8 Baidu, 11 any S3-compatible store (also set S3_ENDPOINT).
AGORA_RECORDING_VENDOR=1

# The same region twice: Agora's integer, then the AWS spelling. They must
# describe the same place.
AGORA_RECORDING_STORAGE_REGION=0
AGORA_RECORDING_S3_REGION=us-east-1

# Vendor 11 only — full URL, e.g. https://<id>.r2.cloudflarestorage.com.
# PATH_STYLE is for MinIO and similar.
AGORA_RECORDING_S3_ENDPOINT=
AGORA_RECORDING_S3_PATH_STYLE=false

# CDN in front of the bucket. Setting it makes recordings public to anyone
# with the URL.
AGORA_RECORDING_PUBLIC_BASE_URL=

# How long a playback link lives (6h). A fresh one is minted on every click.
AGORA_RECORDING_URL_TTL_SECONDS=21600

# Billed per minute. false switches recording off for the whole deployment.
AGORA_RECORDING_ENABLED=true
CLASS_RECORDING_EMAIL_ENABLED=true


# --- Live classes: AI notes --------------------------------------------
# local: the teacher's browser records the class and uploads it here. Needs
#        only GEMINI_API_KEY — no bucket, no extra Agora product.
# agora: Agora transcribes it into the recording bucket above.
CLASS_NOTES_SOURCE=local

# 'local' only. These two set the upload size: 24 kbps x 240 s / 8 = 720 KB,
# inside nginx's default 1 MB limit. Raise either and raise the proxy too.
CLASS_NOTES_AUDIO_SEGMENT_SECONDS=240
CLASS_NOTES_AUDIO_BITRATE=24000
# Largest single segment the server will accept.
CLASS_NOTES_AUDIO_MAX_MB=40

# 'agora' only. Leave empty to use AGORA_CUSTOMER_ID / _SECRET above.
AGORA_STT_CUSTOMER_ID=
AGORA_STT_CUSTOMER_SECRET=
# 'agora' only. At most four languages.
CLASS_NOTES_LANGUAGES=en-US

# Notes need GEMINI_API_KEY on either source.
CLASS_NOTES_ENABLED=true
CLASS_NOTES_EMAIL_ENABLED=true
