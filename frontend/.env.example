NEXT_PUBLIC_API_URL=https://api.coolnerdz.com/api

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). This is a public identifier, safe to expose client-side —
# must match the backend's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Agora RTC App ID — the live classroom (Teacher Portal > Live Classes,
# Student Portal > Live Classes). A public identifier, safe in the browser:
# a channel can only be joined with a token the backend signs with the App
# Certificate, which never leaves the server. Must be the same Agora project
# as the backend's AGORA_APP_ID / AGORA_APP_CERTIFICATE.
NEXT_PUBLIC_AGORA_APP_ID=
