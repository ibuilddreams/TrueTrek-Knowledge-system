# Deploy user sudoers — allow service restart/reload and controlled git pull without password
truetrek ALL=(root) NOPASSWD: /bin/systemctl restart truetrek-backend, /bin/systemctl restart truetrek-frontend, /bin/systemctl reload nginx, /bin/systemctl status truetrek-backend, /bin/systemctl status truetrek-frontend, /bin/systemctl is-active truetrek-backend, /bin/systemctl is-active truetrek-frontend, /bin/systemctl is-active nginx, /opt/TrueTrek-Knowledge-system/deploy/git-pull.sh
