# Deploy user — passwordless sudo limited to deploy/restart commands only.
# Command arguments must match deploy/deploy.sh exactly (sudoers is strict).
truetrek ALL=(root) NOPASSWD: \
  /bin/systemctl restart truetrek-backend, \
  /bin/systemctl restart truetrek-frontend, \
  /bin/systemctl reload nginx, \
  /bin/systemctl status truetrek-backend, \
  /bin/systemctl status truetrek-frontend, \
  /bin/systemctl status nginx, \
  /bin/systemctl is-active truetrek-backend, \
  /bin/systemctl is-active truetrek-frontend, \
  /bin/systemctl is-active nginx, \
  /usr/sbin/nginx -t, \
  /opt/TrueTrek-Knowledge-system/deploy/git-pull.sh
